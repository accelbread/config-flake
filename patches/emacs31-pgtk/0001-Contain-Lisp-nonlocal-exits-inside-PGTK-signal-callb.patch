index 81d9503cbc..4f99c5d377 100644
--- a/src/pgtkim.c
+++ b/src/pgtkim.c
@@ -242,20 +242,20 @@ pgtk_im_use_context (struct pgtk_display_info *dpyinfo, bool use_p)
       if (dpyinfo->im.context == NULL)
 	{
 	  dpyinfo->im.context = gtk_im_multicontext_new ();
-	  g_signal_connect (dpyinfo->im.context, "commit",
+	  pgtk_signal_connect (dpyinfo->im.context, "commit",
 			    G_CALLBACK (im_context_commit_cb), dpyinfo);
-	  g_signal_connect (dpyinfo->im.context, "retrieve-surrounding",
+	  pgtk_signal_connect (dpyinfo->im.context, "retrieve-surrounding",
 			    G_CALLBACK (im_context_retrieve_surrounding_cb),
 			    dpyinfo);
-	  g_signal_connect (dpyinfo->im.context, "delete-surrounding",
+	  pgtk_signal_connect (dpyinfo->im.context, "delete-surrounding",
 			    G_CALLBACK (im_context_delete_surrounding_cb),
 			    dpyinfo);
-	  g_signal_connect (dpyinfo->im.context, "preedit-changed",
+	  pgtk_signal_connect (dpyinfo->im.context, "preedit-changed",
 			    G_CALLBACK (im_context_preedit_changed_cb),
 			    dpyinfo);
-	  g_signal_connect (dpyinfo->im.context, "preedit-end",
+	  pgtk_signal_connect (dpyinfo->im.context, "preedit-end",
 			    G_CALLBACK (im_context_preedit_end_cb), dpyinfo);
-	  g_signal_connect (dpyinfo->im.context, "preedit-start",
+	  pgtk_signal_connect (dpyinfo->im.context, "preedit-start",
 			    G_CALLBACK (im_context_preedit_start_cb),
 			    dpyinfo);
 	  gtk_im_context_set_use_preedit (dpyinfo->im.context, TRUE);
diff --git a/src/pgtkterm.c b/src/pgtkterm.c
index 733c7d27c4..9127a4eccd 100644
--- a/src/pgtkterm.c
+++ b/src/pgtkterm.c
@@ -6824,12 +6824,83 @@ static gboolean pgtk_selection_event (GtkWidget *, GdkEvent *, gpointer);
 
 
 
+
+/* A Lisp nonlocal exit must not cross g_closure_invoke or signal emission:
+   GLib keeps stack-allocated Emission entries until those calls return.
+   Install the catch inside the closure marshaller, so even errors from
+   mouse highlighting and redisplay return normally to GLib.  */
+struct pgtk_callback_invocation
+{
+  GClosure *closure;
+  GValue *return_value;
+  guint n_parameters;
+  const GValue *parameters;
+  gpointer invocation_hint;
+  gpointer marshal_data;
+  bool completed;
+};
+
+static Lisp_Object
+pgtk_invoke_callback (void *arg)
+{
+  struct pgtk_callback_invocation *invocation = arg;
+  g_cclosure_marshal_generic (invocation->closure, invocation->return_value,
+                             invocation->n_parameters, invocation->parameters,
+                             invocation->invocation_hint,
+                             invocation->marshal_data);
+  invocation->completed = true;
+  return Qnil;
+}
+
+static Lisp_Object
+pgtk_discard_callback_exit (enum nonlocal_exit type, Lisp_Object value)
+{
+  /* Do not signal, allocate Lisp objects, or call Lisp from this handler.  */
+  return Qnil;
+}
+
+static void
+pgtk_marshal_callback (GClosure *closure, GValue *return_value,
+                       guint n_parameters, const GValue *parameters,
+                       gpointer invocation_hint, gpointer marshal_data)
+{
+  struct pgtk_callback_invocation invocation =
+    { closure, return_value, n_parameters, parameters,
+      invocation_hint, marshal_data, false };
+
+  internal_catch_all (pgtk_invoke_callback, &invocation,
+                      pgtk_discard_callback_exit);
+  if (!invocation.completed)
+    {
+      /* Also covers failure to allocate the catch handler.  In particular,
+         a failed boolean event handler must not reuse a previous result.  */
+      if (return_value && G_VALUE_TYPE (return_value))
+        g_value_reset (return_value);
+      GSignalInvocationHint *hint = invocation_hint;
+      fprintf (stderr, "PGTK: discarded nonlocal exit or skipped callback"
+               " for signal %s\n",
+               hint ? g_signal_name (hint->signal_id) : "(unknown)");
+    }
+}
+
+/* Like g_signal_connect for PGTK's frame and input-method callbacks.
+   These connections are removed by handler ID or object destruction;
+   a custom marshaller does not support GLib's matching by callback function.  */
+gulong
+pgtk_signal_connect (gpointer instance, const gchar *signal,
+                     GCallback callback, gpointer data)
+{
+  GClosure *closure = g_cclosure_new (callback, data, NULL);
+  g_closure_set_marshal (closure, pgtk_marshal_callback);
+  return g_signal_connect_closure (instance, signal, closure, FALSE);
+}
+
 void
 pgtk_set_event_handler (struct frame *f)
 {
   if (f->tooltip)
     {
-      g_signal_connect (G_OBJECT (FRAME_GTK_WIDGET (f)), "draw",
+      pgtk_signal_connect (G_OBJECT (FRAME_GTK_WIDGET (f)), "draw",
 			G_CALLBACK (pgtk_handle_draw), NULL);
       return;
     }
@@ -6840,62 +6911,62 @@ pgtk_set_event_handler (struct frame *f)
 
   if (FRAME_GTK_OUTER_WIDGET (f))
     {
-      g_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)),
+      pgtk_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)),
 			"window-state-event", G_CALLBACK (window_state_event),
 			NULL);
-      g_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)), "delete-event",
+      pgtk_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)), "delete-event",
 			G_CALLBACK (delete_event), NULL);
-      g_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)), "event",
+      pgtk_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)), "event",
 			G_CALLBACK (pgtk_handle_event), NULL);
-      g_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)), "configure-event",
+      pgtk_signal_connect (G_OBJECT (FRAME_GTK_OUTER_WIDGET (f)), "configure-event",
 			G_CALLBACK (configure_event), NULL);
     }
 
-  g_signal_connect (G_OBJECT (FRAME_GTK_WIDGET (f)), "map-event",
+  pgtk_signal_connect (G_OBJECT (FRAME_GTK_WIDGET (f)), "map-event",
 		    G_CALLBACK (map_event), NULL);
