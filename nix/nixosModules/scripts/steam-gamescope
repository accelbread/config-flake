# SPDX-License-Identifier: AGPL-3.0-or-later

set -euo pipefail

export PATH=@path@

resolution=$(
    busctl --user --json=short call \
        org.gnome.Mutter.DisplayConfig \
        /org/gnome/Mutter/DisplayConfig \
        org.gnome.Mutter.DisplayConfig GetCurrentState |
        jq -er '
            .data[1:3] as [$monitors, $logicalMonitors]
            | first($logicalMonitors[] | select(.[4])) as $primary
            | $monitors[]
            | select(.[0] == $primary[5][0])
            | .[1][]
            | select(.[6]["is-current"].data)
            | .[1:3]
            | if $primary[3] % 2 == 1 then reverse else . end
            | @tsv
        '
)
read -r width height <<< "$resolution"

exec gamescope \
    --backend wayland --expose-wayland --adaptive-sync \
    --xwayland-count 2 -f -e \
    -w "$width" -h "$height" -- \
    bash -c '
        shutdown_steam() {
            flatpak enter com.valvesoftware.Steam /app/bin/steam -shutdown || true
        }
        trap shutdown_steam EXIT
        trap "exit 0" HUP INT TERM
        flatpak run com.valvesoftware.Steam -gamepadui "$@" &
        wait "$!"
    ' steam-gamescope-session "$@"
