set -xeuo pipefail

export PATH=@path@

umask 077

hostname=$(</etc/hostname)

if [[ ! -e /persist/state/system/keys/ssh_host_ed25519_sk_key ]]; then
    ssh-keygen -t ed25519-sk -O no-touch-required -N "" -C "$hostname" \
        -f /persist/state/system/keys/ssh_host_ed25519_sk_key
fi
if [[ ! -e /persist/state/system/keys/remote_build_ssh_key ]]; then
    ssh-keygen -t ed25519-sk -O no-touch-required -N "" \
        -C "$hostname remotebuild" \
        -f /persist/state/system/keys/remote_build_ssh_key
fi
if [[ ! -s ~archit/.ssh/id_ed25519_sk ]]; then
    ssh-keygen -t ed25519-sk -O verify-required -N "" -C "archit@$hostname" \
        -f ~archit/.ssh/id_ed25519_sk <<< y
fi
if [[ ! -e ~archit/.ssh/id_ed25519_sk.pub ]]; then
    ssh-keygen -y -f ~archit/.ssh/id_ed25519_sk > ~archit/.ssh/id_ed25519_sk.pub
fi

ssh-keygen \
    -s @flake@/misc/ssh_ca_key.pub \
    -D @yubico-piv-tool@/lib/libykcs11.so \
    -h \
    -I "$hostname" \
    -n "$hostname.fluffy-bebop.ts.net" \
    -O no-touch-required \
    /persist/state/system/keys/ssh_host_ed25519_sk_key.pub
ssh-keygen \
    -s @flake@/misc/ssh_ca_key.pub \
    -D @yubico-piv-tool@/lib/libykcs11.so \
    -I "$hostname remotebuild" \
    -n remotebuild \
    -O no-touch-required \
    /persist/state/system/keys/remote_build_ssh_key.pub
ssh-keygen \
    -s @flake@/misc/ssh_ca_key.pub \
    -D @yubico-piv-tool@/lib/libykcs11.so \
    -I "archit@$hostname" \
    -n archit \
    ~archit/.ssh/id_ed25519_sk.pub

chown archit: ~archit/.ssh/id_ed25519_sk{,.pub,-cert.pub}

/run/current-system/sw/bin/systemctl restart sshd.service

export PKCS11_MODULE_PATH=@yubico-piv-tool@/lib/libykcs11.so

provision_x509() {
    local directory=$1 subject=$2 owner=$3

    if [[ ! -e "$directory/key.pem" ]]; then
        openssl genpkey \
            -provider @tpm2-openssl@/lib/ossl-modules/tpm2.so \
            -algorithm EC -pkeyopt group:P-384 -out "$directory/key.pem"
    fi

    openssl x509 -new \
        -provider default \
        -provider @libp11@/lib/ossl-module/pkcs11prov.so \
        -provider @tpm2-openssl@/lib/ossl-modules/tpm2.so \
        -force_pubkey "$directory/key.pem" -subj "$subject" \
        -CA @flake@/misc/ca.pem -CAkey 'pkcs11:id=%05;type=private' \
        -days 3650 -sha512 \
        -extfile <(printf '%s\n' 'keyUsage=critical,digitalSignature') \
        -out "$directory/cert.pem"
    chown "$owner:" "$directory"/{key,cert}.pem
    chmod 0600 "$directory"/{key,cert}.pem
}

provision_x509 /var/lib/x509 "/CN=$hostname/OU=machine" root
provision_x509 ~archit/.local/share/x509 "/CN=archit@$hostname/OU=user" archit
