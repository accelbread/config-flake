set -euo pipefail

if ! kagi_token="$(secret-tool lookup api_token kagi)"; then
  echo "Kagi API token unavailable" >&2
  echo "Store it with: secret-tool store --label='Kagi API token' api_token kagi" >&2
  exit 78
fi

exec caddy run --config - --adapter caddyfile <<EOF
{
  admin off
  persist_config off
}

http://127.0.0.1:25619 {
  bind 127.0.0.1
  handle_path /kagi/* {
    reverse_proxy https://mcp.kagi.com {
      header_up Authorization "Bearer $kagi_token"
    }
  }
}
EOF
